[node name="JohnnyGetDialogue" parent="BuiltInObjects/JohnnyNpcArea" index="4" instance=ExtResource("9_kqnn8")]
layer = 4

[node name="DialogueStandard" parent="BuiltInObjects/JohnnyNpcArea/JohnnyGetDialogue" index="1" instance=ExtResource("10_7iaxr")]
text = "Hey, Jeffrey! Thank you for saving me!"
top = true

[node name="DialogueStandard2" parent="BuiltInObjects/JohnnyNpcArea/JohnnyGetDialogue" index="2" instance=ExtResource("10_7iaxr")]
text = "I recently got split up, and all the tiny me's got spread around this land."
top = true

[node name="DialogueStandard3" parent="BuiltInObjects/JohnnyNpcArea/JohnnyGetDialogue" index="3" instance=ExtResource("10_7iaxr")]
text = "As you have been collecting the little me's, more and more of me has been put back together!"
top = true

[node name="DialogueStandard4" parent="BuiltInObjects/JohnnyNpcArea/JohnnyGetDialogue" index="4" instance=ExtResource("10_7iaxr")]
text = "You haven't found all of them yet, so I am still missing some organs... but I have enough to be up and running again!"
top = true

[node name="DialogueStandard5" parent="BuiltInObjects/JohnnyNpcArea/JohnnyGetDialogue" index="5" instance=ExtResource("10_7iaxr")]
text = "You know, if you can get the last smol me's, I might have a little surprise for you upstairs..."
top = true

[node name="DialogueStandard6" parent="BuiltInObjects/JohnnyNpcArea/JohnnyGetDialogue" index="6" instance=ExtResource("10_7iaxr")]
text = "But in any case, whaddaya say? Want to hit the showers and let me take over for a while?"
top = true
yes_or_no = true

[node name="JohnnyGetDialogueFull" parent="BuiltInObjects/JohnnyNpcArea" index="5" instance=ExtResource("9_kqnn8")]
layer = 4

[node name="DialogueStandard" parent="BuiltInObjects/JohnnyNpcArea/JohnnyGetDialogueFull" index="1" instance=ExtResource("10_7iaxr")]
text = "Hey, Jeffrey! Thank you for saving me!"
top = true

[node name="DialogueStandard2" parent="BuiltInObjects/JohnnyNpcArea/JohnnyGetDialogueFull" index="2" instance=ExtResource("10_7iaxr")]
text = "I recently got split up, and all the tiny me's got spread around this land."
top = true

[node name="DialogueStandard3" parent="BuiltInObjects/JohnnyNpcArea/JohnnyGetDialogueFull" index="3" instance=ExtResource("10_7iaxr")]
text = "As you have been collecting the little me's, more and more of me has been put back together!"
top = true

[node name="DialogueStandard4" parent="BuiltInObjects/JohnnyNpcArea/JohnnyGetDialogueFull" index="4" instance=ExtResource("10_7iaxr")]
text = "And... wow! You got all of them! I am whole again! Thank you so much, that must've been so hard!"
top = true

[node name="DialogueStandard5" parent="BuiltInObjects/JohnnyNpcArea/JohnnyGetDialogueFull" index="5" instance=ExtResource("10_7iaxr")]
text = "I have a little surprise for you because you have been so awesome! It's upstairs, you just have to press space at that sign."
top = true

[node name="DialogueStandard6" parent="BuiltInObjects/JohnnyNpcArea/JohnnyGetDialogueFull" index="6" instance=ExtResource("10_7iaxr")]
text = "But you must be so tired! Want to hit the showers and let me take over for a while?"
top = true
yes_or_no = true

